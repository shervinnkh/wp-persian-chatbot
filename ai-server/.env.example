# Persian WP Chatbot Server — configuration
# Copy to .env and fill the empty secrets. Never commit .env.
# Generate a secret:  python -c "import secrets; print(secrets.token_hex(32))"

# ---- Docker deployment (docker-compose.yml) ----
# Created for you by:  bash deploy/init-env.sh
# Public domain of this server (Caddy issues the HTTPS certificate for it). Docker only.
DOMAIN=

# ---- App ----
# development | production (production forces REQUIRE_HTTPS=true, RELOAD=false, QDRANT_MODE=server)
APP_ENV=development
HOST=127.0.0.1
PORT=8000
RELOAD=false
# Must stay 1: queues, WebSocket manager and replay cache live in one process
WORKERS=1
# Proxy IPs allowed to set X-Forwarded-* (nginx on the same host = 127.0.0.1)
FORWARDED_ALLOW_IPS=127.0.0.1
# /docs is on in development, off in production unless set
# ENABLE_DOCS=true

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=false
LOG_TO_FILE=true
LOG_DIR=logs
LOG_MAX_MB=10
LOG_BACKUP_COUNT=10

# ---- Auth (HMAC-SHA256) ----
# Shared key; must equal the plugin's PWC_API_SECRET. Hex: at least 64 chars. (secret)
API_SHARED_SECRET=
AUTH_MAX_SKEW_SECONDS=300
MAX_BODY_BYTES=5000000
# true in production (TLS terminates at the reverse proxy)
REQUIRE_HTTPS=false
# Optional IP/CIDR allowlist, comma separated. Empty = off
ALLOWED_IPS=
# Reject a repeated signed request (replay protection)
REPLAY_PROTECTION=true

# ---- Paths ----
DATA_DIR=data
UPLOADS_DIR=uploads
# Total size of stored knowledge files
UPLOADS_MAX_TOTAL_MB=200

# ---- Database (records, chunks, conversations) ----
# Empty = SQLite (data/app.db). Or e.g. postgresql+asyncpg://user:pass@127.0.0.1/dbname
DATABASE_URL=
# Pool settings apply to PostgreSQL only
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true

# ---- Qdrant (vector DB) ----
# server   = Qdrant server at QDRANT_URL (required in production)
# embedded = inside this process, data in QDRANT_PATH (development, one process)
QDRANT_MODE=embedded
QDRANT_PATH=data/qdrant
QDRANT_URL=http://127.0.0.1:6333
# Required in production (secret)
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge
QDRANT_TIMEOUT=30
QDRANT_SCALAR_QUANTIZATION=false

# ---- OpenAI or any OpenAI-compatible API ----
# (secret)
OPENAI_API_KEY=
# Empty = api.openai.com; set it to use a gateway/proxy
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-large
# Changing dimensions needs a new QDRANT_COLLECTION
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3
# Cache of recent question embeddings (0 = off)
EMBEDDING_CACHE_SIZE=500

# ---- Chunking ----
TIKTOKEN_ENCODING=cl100k_base
TIKTOKEN_CACHE_DIR=data/tiktoken_cache
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=80

# ---- WordPress site ----
# Attachments and knowledge files are downloaded only from this host
PLUGIN_BASE_URL=https://your-site.com
# Callback/tool signing key. Empty = API_SHARED_SECRET (secret)
PLUGIN_CALLBACK_SECRET=
MESSAGE_ATTACHMENT_MAX_MB=20
MESSAGE_DOWNLOAD_TIMEOUT=30

# ---- AI answers ----
# Comma separated; the first is the default when the plugin sends none or an unknown one
AI_ALLOWED_MODELS=gpt-5.4-mini
# USD per 1M tokens (in / cached_in / out); STT: per_minute. Every model in use needs a price
MODEL_PRICES_JSON={"gpt-5.4-mini":{"in":0.75,"cached_in":0.075,"out":4.50},"gpt-4.1-mini":{"in":0.40,"out":1.60},"whisper-1":{"per_minute":0.006},"text-embedding-3-large":{"in":0.13}}
# formal | friendly (the plugin may send its own per message)
DEFAULT_TONE=formal
TONE_FORMAL="Formal and professional. Be polite and respectful, write complete, well-formed sentences, and avoid slang, jokes and emojis. In Persian address the visitor with «شما» and use the formal written register."
TONE_FRIENDLY="Friendly and warm, like a helpful, upbeat shop assistant chatting with a customer. Sound natural and conversational with short sentences; light colloquial Persian is fine (still polite: address the visitor with «شما» unless they use «تو»). At most one emoji per message, and never slang or anything that could offend."
# Retrieval: number of chunks in the prompt, minimum cosine score (0 = off)
RAG_TOP_K=3
RAG_MIN_SCORE=0
# Reasoning models count hidden reasoning here: keep it generous
ANSWER_MAX_OUTPUT_TOKENS=2000
ANSWER_LLM_TIMEOUT=90
ANSWER_LLM_MAX_RETRIES=2
# json_schema | json_object | none
ANSWER_RESPONSE_FORMAT=json_schema
# minimal | low | medium | high (reasoning models only; empty = not sent)
ANSWER_REASONING_EFFORT=
# AI calls per visitor message; 1 disables live-data tools
ANSWER_MAX_LLM_ROUNDS=2
# site | conversation | off (OpenAI prompt cache key)
ANSWER_PROMPT_CACHE_KEY=site

# ---- Answer queue ----
ANSWER_QUEUE_MAX=500
ANSWER_WORKER_CONCURRENCY=50
ANSWER_WORKER_POLL_SECONDS=1
ANSWER_MAX_ATTEMPTS=3
ANSWER_RETRY_DELAY_SECONDS=5
ANSWER_STALE_SECONDS=300
ANSWER_CALLBACK_MAX_ATTEMPTS=4
ANSWER_CALLBACK_TTL_SECONDS=600

# ---- Cost caps (USD, 0 = no cap) ----
BUDGET_DAILY_USD_MAX=5
BUDGET_MONTHLY_USD_MAX=50
# Where a day/month starts, e.g. Asia/Tehran
BUDGET_TIMEZONE=UTC

# ---- Conversation history + summaries ----
# Worker: python -m app.workers.summarizer
HISTORY_RECENT_PAIRS=3
SUMMARY_TRIGGER_TOKENS=3000
SUMMARY_MODEL=gpt-4.1-mini
SUMMARY_MAX_OUTPUT_TOKENS=1200
SUMMARY_TIMEOUT=120
SUMMARY_MAX_RETRIES=2
SUMMARY_MAX_ATTEMPTS=3
SUMMARY_RETRY_DELAY_SECONDS=30
SUMMARY_WORKER_POLL_SECONDS=3
SUMMARY_STALE_SECONDS=600
# Delete conversations older than this (0 = keep)
CONVERSATION_RETENTION_DAYS=90

# ---- Ingestion queue ----
# Worker: python -m app.workers.ingestion. INGEST_RUN_IN_API empty = auto (on with embedded Qdrant)
INGEST_RUN_IN_API=
INGEST_WORKER_CONCURRENCY=2
INGEST_WORKER_POLL_SECONDS=1
INGEST_MAX_ATTEMPTS=3
INGEST_RETRY_DELAY_SECONDS=30
INGEST_STALE_SECONDS=900
INGEST_RETENTION_DAYS=7

# ---- Result callbacks (server -> plugin) ----
# Worker: python -m app.workers.delivery (run exactly one)
# Development only: allow http:// and private hosts
CALLBACK_ALLOW_PRIVATE_NETWORKS=false
CALLBACK_BATCH_WINDOW_SECONDS=10
CALLBACK_INITIAL_BATCH_SIZE=50
CALLBACK_CONNECT_TIMEOUT=3
CALLBACK_TOTAL_TIMEOUT=10
CALLBACK_MAX_CONCURRENCY=8
CALLBACK_MIN_INTERVAL_SECONDS=1
CALLBACK_MAX_ATTEMPTS=8
CALLBACK_BREAKER_FAILURES=5
CALLBACK_PING_INTERVAL_SECONDS=300
CALLBACK_WORKER_POLL_SECONDS=2

# ---- Knowledge files (PDF / DOCX / TXT) ----
FILES_MAX_MB=100
FILES_KEEP_ORIGINAL=true
FILES_CONNECT_TIMEOUT=10
FILES_READ_TIMEOUT=60
FILES_DOWNLOAD_RETRIES=2
FILES_MAX_EXTRACTED_CHARS=3000000

# ---- Live-data tools (server -> plugin) ----
TOOLS_PRODUCTS_PATH=/wp-json/pwc/v1/live/products
TOOLS_DYNAMIC_PATH=/wp-json/pwc/v1/live/tool
TOOLS_TIMEOUT=10
TOOLS_MAX_CALLS_PER_ROUND=4
TOOLS_MAX_PRODUCTS_PER_CALL=5
TOOLS_MAX_DYNAMIC=30
TOOLS_MAX_RESULT_CHARS=12000

# ---- Voice (speech-to-text) ----
STT_MODEL=whisper-1
# ISO-639-1 hint; empty = auto-detect
STT_LANGUAGE=fa
STT_TIMEOUT=120

# ---- Images ----
IMAGE_MAX_KB=1024
# auto | low | high
IMAGE_DETAIL=auto

# ---- Rate limits (per minute) ----
RATE_PER_IP_PER_MIN=30
RATE_PER_VISITOR_PER_MIN=10
# Visitor IP hashes are cleared after this many days
IP_HASH_RETENTION_DAYS=30

# ---- Realtime (WebSocket, notify-only) ----
WS_ENABLED=true
# Comma separated origins; empty = PLUGIN_BASE_URL
WS_ALLOWED_ORIGINS=
WS_MAX_PER_VISITOR=3
WS_MAX_TOTAL=2000
WS_MAX_UNAUTH=200
WS_MAX_LIFETIME_SEC=1800
WS_AUTH_TIMEOUT_SEC=5
WS_PING_INTERVAL_SEC=25
WS_IDLE_TIMEOUT_SEC=70
WS_MAX_MESSAGE_BYTES=1024
WS_MAX_MSG_PER_SEC=10
WS_TOKEN_MAX_TTL_SEC=900
WS_PUSH_MAX_SKEW_SECONDS=60
# Empty = http://127.0.0.1:<PORT>
WS_INTERNAL_URL=

# ---- Monitoring (JSONL events + roll-ups) ----
MONITOR_ENABLED=true
# Empty = <LOG_DIR>/monitoring
MONITOR_DIR=
# Day boundary, e.g. +03:30 for Tehran
MONITOR_UTC_OFFSET=+00:00
# MONITOR_MAX_MB=10          # default: LOG_MAX_MB
# MONITOR_MAX_PARTS=10       # default: LOG_BACKUP_COUNT
MONITOR_MAX_TOTAL_MB=2048
MONITOR_RETENTION_DAYS=400
MONITOR_COMPRESS=true
MONITOR_QUEUE_SIZE=20000
MONITOR_FLUSH_SECONDS=1
MONITOR_SNAPSHOT_SECONDS=60
MONITOR_STORAGE_SNAPSHOT_SECONDS=600
MONITOR_LOG_IP=true
