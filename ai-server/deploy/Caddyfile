# Used by docker-compose.yml. {$DOMAIN} comes from .env; Caddy gets and renews the
# Let's Encrypt certificate by itself (ports 80 and 443 must be reachable from the internet).
# Caddy also sets X-Forwarded-For / X-Forwarded-Proto and proxies WebSocket (/ws) automatically.

{$DOMAIN} {
	encode zstd gzip

	# Keep in sync with MAX_BODY_BYTES in .env (chat/ingestion bodies are small JSON)
	request_body {
		max_size 6MB
	}

	reverse_proxy api:8000 {
		transport http {
			response_header_timeout 120s   # LLM calls can be slow
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
