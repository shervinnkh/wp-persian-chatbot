# ---- Security (v0.8.0): add these lines to .env ----
# S-1 rate limits (fixed 1-minute windows, atomic in the database)
RATE_PER_IP_PER_MIN=30
RATE_PER_VISITOR_PER_MIN=10
IP_HASH_RETENTION_DAYS=30
# S-2 cost cap. Prices: USD per 1M tokens (STT: per audio minute). FILL IN THE REAL PRICES from the
# provider's pricing page (0.00 = the cap cannot see that spending). Every model of
# AI_ALLOWED_MODELS, SUMMARY_MODEL, EMBEDDING_MODEL and STT_MODEL needs an entry
# (production refuses to start otherwise). Empty STT_MODEL = voice transcription off.
MODEL_PRICES_JSON={"gpt-5-4":{"in":0.00,"cached_in":0.00,"out":0.00},"gpt-4.1-mini":{"in":0.00,"cached_in":0.00,"out":0.00},"text-embedding-3-large":{"in":0.00},"whisper-1":{"per_minute":0.00}}
BUDGET_DAILY_USD_MAX=0
BUDGET_MONTHLY_USD_MAX=0
BUDGET_TIMEZONE=UTC
ANSWER_QUEUE_MAX=500
# (Windows: for BUDGET_TIMEZONE=Asia/Tehran run: pip install tzdata)
