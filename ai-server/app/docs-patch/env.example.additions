# ---- این خطوط را به .env.example اضافه کن (همه پیش‌فرض‌ها همان رفتار قبلی را دارند) ----

# دیتابیس: تا چند ده کاربر هم‌زمان SQLite (پیش‌فرض، DATABASE_URL خالی) کافی است؛
# برای production جدی DATABASE_URL پستگرس بگذار، مثلاً:
# DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/paia
# Pool فقط برای PostgreSQL اعمال می‌شود (برای SQLite بی‌اثر است):
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_POOL_PRE_PING=true

# Qdrant: QDRANT_PATH (embedded) فقط برای توسعه است؛ در production خالی بگذار، از Qdrant سرور جدا
# (QDRANT_URL) و worker ingestion جدا (python -m app.workers.ingestion) استفاده کن.
# QDRANT_PATH=data/qdrant
# QDRANT_URL=http://127.0.0.1:6333

# حجم و هزینهٔ بردارها: هر بردار ≈ EMBEDDING_DIMENSIONS x 4 بایت (3072 ≈ 12KB، 1024 ≈ 4KB).
# برای نصب جدید می‌شود مدل را text-embedding-3-small گذاشت یا بُعد را کم کرد (مثلاً 1024).
# هشدار: تغییر مدل/بُعد روی کالکشن موجود = ingestion مجدد کل دانش (QDRANT_COLLECTION جدید + force=true)؛
# برای نصب‌های موجود این مقادیر را عوض نکن.
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072
# اختیاری: int8 scalar quantization (حدود 4 برابر RAM کمتر)؛ فقط هنگام ساخت کالکشن جدید اعمال می‌شود.
# QDRANT_SCALAR_QUANTIZATION=false
