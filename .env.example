# Copy to .env (run.bat does this automatically on first run).

# ---- App ----
# development | production  (production forces REQUIRE_HTTPS=true and RELOAD=false)
APP_ENV=development
HOST=127.0.0.1
PORT=8000
RELOAD=true
WORKERS=1
# Proxy IPs allowed to set X-Forwarded-* (nginx on the same VPS = 127.0.0.1)
FORWARDED_ALLOW_IPS=127.0.0.1
# /docs is on in development and off in production unless set explicitly:
# ENABLE_DOCS=true

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=false
LOG_TO_FILE=true
LOG_DIR=logs
LOG_MAX_MB=10
LOG_BACKUP_COUNT=10

# ---- Auth (HMAC-SHA256 over timestamp + "\n" + body) ----
# Generate: python scripts/generate_secret.py --write
# Hex secrets need >= 64 chars (32 random bytes); other formats >= 43 chars.
API_SHARED_SECRET=
AUTH_MAX_SKEW_SECONDS=300
MAX_BODY_BYTES=5000000
# Must be true in production (TLS terminates at nginx; it sends X-Forwarded-Proto)
REQUIRE_HTTPS=false
# Optional app-level allowlist (comma separated IPs/CIDRs). Empty = disabled.
# The VPS firewall (deploy/firewall-ufw.sh) is the primary layer.
ALLOWED_IPS=

# ---- Paths ----
DATA_DIR=data
UPLOADS_DIR=uploads

# ---- Text database (records + chunks) ----
# Empty = SQLite file data/app.db. Or any SQLAlchemy async URL, e.g.
# postgresql+asyncpg://user:pass@127.0.0.1/ai_backend   (needs `pip install asyncpg`)
DATABASE_URL=

# ---- Qdrant (vector DB) ----
# Development without a Qdrant server: embedded mode, data stored in this folder
# (one process only; leave EMPTY to use a real server at QDRANT_URL).
QDRANT_PATH=data/qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge
QDRANT_TIMEOUT=30

# ---- Embeddings (OpenAI API or any OpenAI-compatible gateway) ----
OPENAI_API_KEY=
# Leave empty for api.openai.com; set it when requests must go through a proxy/gateway.
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-large
# Changing the dimensions needs a NEW QDRANT_COLLECTION (or recreate it) + re-sending records.
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3

# ---- Chunking ----
# Token counts use tiktoken. The vocabulary is downloaded once into TIKTOKEN_CACHE_DIR;
# if the server cannot reach openaipublic.blob.core.windows.net the counter falls back to
# an approximation (warning in the log).
TIKTOKEN_ENCODING=cl100k_base
TIKTOKEN_CACHE_DIR=data/tiktoken_cache
# A text up to MAX stays ONE chunk. Longer texts are cut at ~TARGET tokens (paragraph/sentence
# boundaries) with OVERLAP tokens repeated; pieces under MIN tokens are merged.
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=80

# ---- Messaging (chat messages + image/voice attachments) ----
# WordPress site address. Attachments are downloaded ONLY from this host (SSRF protection);
# empty = attachments are saved as messages but never downloaded.
PLUGIN_BASE_URL=
MESSAGE_ATTACHMENT_MAX_MB=20
MESSAGE_DOWNLOAD_TIMEOUT=30

# ---- Conversation history + summarization ----
# History for the AI = last summary + the last HISTORY_RECENT_PAIRS (user + reply) pairs in full
# + the newest user message. When the token count of the whole unsummarized conversation passes
# SUMMARY_TRIGGER_TOKENS, a summarization request is queued after the answer was returned and the
# summarizer worker (run.bat starts it: python -m app.workers.summarizer) handles it.
# The worker uses OPENAI_API_KEY / OPENAI_BASE_URL from above.
HISTORY_RECENT_PAIRS=3
SUMMARY_TRIGGER_TOKENS=3000
SUMMARY_MODEL=gpt-4.1-mini
SUMMARY_MAX_OUTPUT_TOKENS=1200
SUMMARY_TIMEOUT=120
SUMMARY_MAX_RETRIES=2
SUMMARY_MAX_ATTEMPTS=3
SUMMARY_RETRY_DELAY_SECONDS=30
SUMMARY_WORKER_POLL_SECONDS=3
SUMMARY_STALE_SECONDS=600

# ---- Planned (next steps) ----
# UPLOADS_MAX_TOTAL_MB=200
# PLUGIN_CALLBACK_SECRET=
