# Copy to .env (run.bat does this automatically on first run).

# ---- App ----
# development | production  (production forces REQUIRE_HTTPS=true and RELOAD=false)
APP_ENV=development
HOST=127.0.0.1
PORT=8000
RELOAD=true
WORKERS=1
# Proxy IPs allowed to set X-Forwarded-* (nginx on the same VPS = 127.0.0.1)
FORWARDED_ALLOW_IPS=127.0.0.1
# /docs is on in development and off in production unless set explicitly:
# ENABLE_DOCS=true

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=false
LOG_TO_FILE=true
LOG_DIR=logs
LOG_MAX_MB=10
LOG_BACKUP_COUNT=10

# ---- Auth (HMAC-SHA256 over timestamp + "\n" + body) ----
# Generate: python scripts/generate_secret.py --write
# Hex secrets need >= 64 chars (32 random bytes); other formats >= 43 chars.
API_SHARED_SECRET=
AUTH_MAX_SKEW_SECONDS=300
MAX_BODY_BYTES=5000000
# Must be true in production (TLS terminates at nginx; it sends X-Forwarded-Proto)
REQUIRE_HTTPS=false
# Optional app-level allowlist (comma separated IPs/CIDRs). Empty = disabled.
# The VPS firewall (deploy/firewall-ufw.sh) is the primary layer.
ALLOWED_IPS=

# ---- Paths ----
DATA_DIR=data
UPLOADS_DIR=uploads

# ---- Text database (records + chunks) ----
# Empty = SQLite file data/app.db. Or any SQLAlchemy async URL, e.g.
# postgresql+asyncpg://user:pass@127.0.0.1/ai_backend   (needs `pip install asyncpg`)
DATABASE_URL=

# ---- Qdrant (vector DB) ----
# Development without a Qdrant server: embedded mode, data stored in this folder
# (one process only; leave EMPTY to use a real server at QDRANT_URL).
QDRANT_PATH=data/qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge
QDRANT_TIMEOUT=30

# ---- Embeddings (OpenAI API or any OpenAI-compatible gateway) ----
OPENAI_API_KEY=
# Leave empty for api.openai.com; set it when requests must go through a proxy/gateway.
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-large
# Changing the dimensions needs a NEW QDRANT_COLLECTION (or recreate it) + re-sending records.
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3

# ---- Chunking ----
# Token counts use tiktoken. The vocabulary is downloaded once into TIKTOKEN_CACHE_DIR;
# if the server cannot reach openaipublic.blob.core.windows.net the counter falls back to
# an approximation (warning in the log).
TIKTOKEN_ENCODING=cl100k_base
TIKTOKEN_CACHE_DIR=data/tiktoken_cache
# A text up to MAX stays ONE chunk. Longer texts are cut at ~TARGET tokens (paragraph/sentence
# boundaries) with OVERLAP tokens repeated; pieces under MIN tokens are merged.
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=80

# ---- Messaging (chat messages + image/voice attachments) ----
# WordPress site address. Attachments are downloaded ONLY from this host (SSRF protection);
# empty = attachments are saved as messages but never downloaded.
PLUGIN_BASE_URL=
MESSAGE_ATTACHMENT_MAX_MB=20
MESSAGE_DOWNLOAD_TIMEOUT=30

# ---- Conversation history + summarization ----
# History for the AI = last summary + the last HISTORY_RECENT_PAIRS (user + reply) pairs in full
# + the newest user message. When the token count of the whole unsummarized conversation passes
# SUMMARY_TRIGGER_TOKENS, a summarization request is queued after the answer was returned and the
# summarizer worker (run.bat starts it: python -m app.workers.summarizer) handles it.
# The worker uses OPENAI_API_KEY / OPENAI_BASE_URL from above.
HISTORY_RECENT_PAIRS=3

# ---- AI answer ----
# Model names the plugin may ask for (comma separated; same keys as the plugin's "AI service"
# select). The FIRST one is the default: used when the plugin sends none or one not in the list.
AI_ALLOWED_MODELS=gpt-5-4

# Tone of the answers. The plugin sends tone=formal|friendly with each message; if it sends none
# the DEFAULT_TONE is used. The text of the chosen tone goes into the system prompt (write it in
# English; the answer itself is in the visitor's language). Keep each value on ONE line, quoted.
DEFAULT_TONE=formal
TONE_FORMAL="Formal and professional. Be polite and respectful, write complete, well-formed sentences, and avoid slang, jokes and emojis. In Persian address the visitor with «شما» and use the formal written register."
TONE_FRIENDLY="Friendly and warm, like a helpful, upbeat shop assistant chatting with a customer. Sound natural and conversational with short sentences; light colloquial Persian is fine (still polite: address the visitor with «شما» unless they use «تو»). At most one emoji per message, and never slang or anything that could offend."

# ---- Real answers: RAG + LLM (needs OPENAI_API_KEY; empty key = fixed placeholder answer) ----
# The visitor's question is embedded and the RAG_TOP_K most similar chunks go into the prompt.
# RAG_MIN_SCORE (cosine 0..1, 0 = off): drop weak matches; tune it using the rag.retrieved log.
RAG_TOP_K=3
RAG_MIN_SCORE=0
# Reasoning models count hidden reasoning inside this limit: keep it generous.
ANSWER_MAX_OUTPUT_TOKENS=2000
ANSWER_LLM_TIMEOUT=90
ANSWER_LLM_MAX_RETRIES=2
# json_schema (OpenAI strict) | json_object (many compatible gateways) | none
ANSWER_RESPONSE_FORMAT=json_schema
# Optional, reasoning models only: minimal | low | medium | high (empty = not sent)
ANSWER_REASONING_EFFORT=

# ---- Async AI answers (request has generate_ai_answer=true + callback) ----
# The API replies "queued" at once; a loop inside the API process generates the answers (network
# I/O only, so a high concurrency is cheap) and the delivery worker POSTs each one to the site.
ANSWER_WORKER_CONCURRENCY=50
ANSWER_MAX_ATTEMPTS=3
ANSWER_RETRY_DELAY_SECONDS=5
# Delivering the finished answer: stop after this many failed sends or this many seconds.
ANSWER_CALLBACK_MAX_ATTEMPTS=4
ANSWER_CALLBACK_TTL_SECONDS=600
SUMMARY_TRIGGER_TOKENS=3000
SUMMARY_MODEL=gpt-4.1-mini
SUMMARY_MAX_OUTPUT_TOKENS=1200
SUMMARY_TIMEOUT=120
SUMMARY_MAX_RETRIES=2
SUMMARY_MAX_ATTEMPTS=3
SUMMARY_RETRY_DELAY_SECONDS=30
SUMMARY_WORKER_POLL_SECONDS=3
SUMMARY_STALE_SECONDS=600

# ---- Ingestion queue (records/texts/files) ----
# POST/PUT/DELETE /v1/knowledge/records only validate + queue and answer 200 at once. The ingestion
# worker (run.bat starts it: python -m app.workers.ingestion) does chunk -> embed -> Qdrant + DB.
# Embedded Qdrant (QDRANT_PATH set) can be opened by one process only: then the same loop runs
# inside the API automatically (leave INGEST_RUN_IN_API empty = auto; true/false forces it).
INGEST_RUN_IN_API=
INGEST_WORKER_CONCURRENCY=2
INGEST_WORKER_POLL_SECONDS=1
INGEST_MAX_ATTEMPTS=3
INGEST_RETRY_DELAY_SECONDS=30
INGEST_STALE_SECONDS=900
INGEST_RETENTION_DAYS=7

# ---- Completion callbacks (AI server -> plugin, sent by the delivery worker) ----
# When a record is finished the plugin is called at the callback.url it sent with the request,
# signed with PLUGIN_CALLBACK_SECRET (empty = API_SHARED_SECRET = the plugin's api_key).
# run.bat starts the worker: python -m app.workers.delivery (run exactly one).
PLUGIN_CALLBACK_SECRET=
# Development only (never in production): allow http:// and private/loopback callback hosts.
CALLBACK_ALLOW_PRIVATE_NETWORKS=false
CALLBACK_BATCH_WINDOW_SECONDS=10
CALLBACK_INITIAL_BATCH_SIZE=50
CALLBACK_CONNECT_TIMEOUT=3
CALLBACK_TOTAL_TIMEOUT=10
CALLBACK_MAX_CONCURRENCY=8
CALLBACK_MIN_INTERVAL_SECONDS=1
CALLBACK_MAX_ATTEMPTS=8
CALLBACK_BREAKER_FAILURES=5
CALLBACK_PING_INTERVAL_SECONDS=300
CALLBACK_WORKER_POLL_SECONDS=2

# ---- AI loop + live-data tools (0.6.0) ----
# Max AI calls per visitor message (K). Round 1 may call tools (live data); the LAST round never
# gets tools and must produce the final answer. 2 = at most two AI calls. 1 = tools disabled.
ANSWER_MAX_LLM_ROUNDS=2
# The tools call the WordPress site (host = PLUGIN_BASE_URL), signed with PLUGIN_CALLBACK_SECRET
# (empty there = API_SHARED_SECRET). Paths are fixed here, never taken from a request.
TOOLS_PRODUCTS_PATH=/wp-json/paia/v1/live/products
TOOLS_DYNAMIC_PATH=/wp-json/paia/v1/live/tool
TOOLS_TIMEOUT=10
TOOLS_MAX_CALLS_PER_ROUND=4
TOOLS_MAX_PRODUCTS_PER_CALL=5
TOOLS_MAX_DYNAMIC=30
TOOLS_MAX_RESULT_CHARS=12000

# ---- Voice messages: speech-to-text (uses OPENAI_API_KEY / OPENAI_BASE_URL) ----
STT_MODEL=whisper-1
STT_LANGUAGE=fa
STT_TIMEOUT=120

# ---- Images sent to the AI (needs `pip install Pillow` for resizing) ----
# A bigger image is re-encoded (JPEG, scaled down) until it is at most this many KB.
IMAGE_MAX_KB=1024
# auto | low | high  (OpenAI vision detail)
IMAGE_DETAIL=auto

# ---- Planned (next steps) ----
# UPLOADS_MAX_TOTAL_MB=200
